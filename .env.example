# Copy to .env and fill in. Never commit .env, never paste these in chat.
VAPI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Subdomain of your workers.dev URL, e.g. sidarthgaonkar
WORKERS_SUBDOMAIN=sidarthgaonkar
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Messaging service the A2P campaign is attached to (optional; when set,
# bought numbers are added to its sender pool)
# Gaonkar Labs A2P service: MG967af7b78109add19d23e89dd763538f (an identifier, not a secret)
TWILIO_MESSAGING_SERVICE_SID=
# Path to the Google service-account JSON used for the calendar mirror
GCP_KEY_FILE=
